PORT=5000
# Set to production on the live server: serves the built website and uses secure cookies.
# NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/nepalstay
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Email sending (verification codes). Leave empty to print codes in the server terminal instead.
# For Gmail: SMTP_USER is your Gmail address, SMTP_PASS is a 16-character Google "App password".
SMTP_USER=
SMTP_PASS=

# Admin login codes are always sent to this address, and nowhere else.
ADMIN_OTP_EMAIL=you@example.com

# "Continue with Google". Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
# with authorised JavaScript origins http://localhost:5173 (and your live https:// address), then paste its Client ID here.
GOOGLE_CLIENT_ID=
